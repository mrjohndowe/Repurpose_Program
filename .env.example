PORT=3080
BASE_URL=http://localhost:3080
POLL_INTERVAL_MS=300000

# TikTok Developer app (source trigger in v0.2)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-PUBLIC-HTTPS-DOMAIN/auth/tiktok/callback

# Google Cloud OAuth client (YouTube destination)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3080/auth/youtube/callback

# Meta/Facebook Developer app (Facebook Page Reel destination)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3080/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v25.0

# Optional publishing defaults
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY=public
YTDLP_PATH=yt-dlp
SESSION_SECRET=change-this-to-a-long-random-string
